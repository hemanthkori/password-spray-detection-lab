# Password Spray Detection — Splunk SPL
# Source: Windows Security EventCode=4625 (failed logon)
# Logic: single source IP hitting >= 10 DISTINCT target accounts in 10 minutes.
#
# Index/sourcetype assumed: index=wineventlog sourcetype=WinEventLog:Security

index=wineventlog sourcetype=WinEventLog:Security EventCode=4625
| eval src=coalesce(IpAddress, Workstation_Name)
| bin _time span=10m
| stats dc(TargetUserName) as distinct_targets, count as total_fails,
        values(TargetUserName) as accounts by src, _time
| where distinct_targets >= 10
| sort - distinct_targets
| fields _time, src, distinct_targets, total_fails, accounts

# Notes:
# - Raise distinct_targets threshold in dense NAT/VPN environments.
# - Add: | search NOT [| inputlookup spray_allowlist.csv | fields src] to suppress known-good sources.
# - Pair with vpn-anomaly-detection to confirm the src IP maps to a real VPN session.
