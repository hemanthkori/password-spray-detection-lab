// Password Spray Detection — Microsoft Sentinel KQL
// Source: SecurityEvent (Windows 4625 failed logon)
// Logic: single source IP hitting >= 10 DISTINCT target accounts within 10 minutes.

let threshold = 10;
let window = 10m;
SecurityEvent
| where EventID == 4625
| extend src = coalesce(IpAddress, WorkstationName, "unknown")
| summarize distinct_targets = dcount(TargetUserName),
            total_fails = count(),
            targeted_accounts = make_set(TargetUserName, 100)
            by src, bin(TimeGenerated, window)
| where distinct_targets >= threshold
| project TimeGenerated, src, distinct_targets, total_fails, targeted_accounts
| order by distinct_targets desc

// Tuning:
// - Allowlist service accounts: add | join kind=leftanti (...) on src
// - Correlate VPN: join with VPN auth table to confirm src is a real tunnel endpoint.
// MITRE: T1110.003
